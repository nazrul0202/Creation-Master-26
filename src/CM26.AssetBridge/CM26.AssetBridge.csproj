<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <AssemblyName>CM26.AssetBridge</AssemblyName>
    <RootNamespace>CM26.AssetBridge</RootNamespace>
    <!-- Runs in-process with the application (single EXE); no console entry point. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CM26.MeshKit\CM26.MeshKit.csproj" />
  </ItemGroup>
</Project>
