<UserControl x:Class="CM26.Studio.Controls.NamedComboField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" Grid.Column="0" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />

        <ComboBox x:Name="Combo" Grid.Column="1" SelectionChanged="Combo_SelectionChanged" />

        <TextBlock Grid.Column="2" Text="*" Foreground="#C00000" FontWeight="Bold" Margin="4,0,0,0"
                   Visibility="Collapsed" x:Name="ModifiedMark" />
    </Grid>
</UserControl>
