<UserControl x:Class="CM26.Studio.Controls.GroupedModelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="140" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <ComboBox x:Name="GroupCombo" Grid.Column="1" Margin="0,0,4,0"
                  SelectionChanged="GroupCombo_SelectionChanged" />
        <ComboBox x:Name="ModelCombo" Grid.Column="2" SelectionChanged="ModelCombo_SelectionChanged" />
        <TextBlock x:Name="ModifiedMark" Grid.Column="3" Text="*" Foreground="#C00000"
                   FontWeight="Bold" Margin="4,0,0,0" Visibility="Collapsed" />
    </Grid>
</UserControl>
