<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Internal WPF control library used only by the classic shell's embedded
         3D preview host. It is deliberately not a launchable Studio app. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CM26.Studio</RootNamespace>
    <AssemblyName>CM26.PreviewHost</AssemblyName>
    <AssemblyTitle>Creation Master 26 Preview Host</AssemblyTitle>
    <Description>Internal WPF controls for embedded CM26 3D previews</Description>
    <ApplicationIcon>..\CM26.App\Assets\Logo\Creation Master 26.ico</ApplicationIcon>
    <HighDpiAwareness>PerMonitorV2</HighDpiAwareness>
    <!-- Version, Company, Product, Copyright and release debug/PathMap settings
         are inherited from Directory.Build.props (single source of truth). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The former Studio application entry point is intentionally excluded.
         Only reusable WPF controls (not a second desktop) are built. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs" />
    <None Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CM26.Application\CM26.Application.csproj" />
    <Reference Include="CM26.EngineBridge">
      <HintPath>..\..\src-native\CM26.EngineBridge\bin\CM26.EngineBridge.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\src-native\CM26.EngineBridge\bin\Ijwhost.dll">
      <Link>Ijwhost.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
  </ItemGroup>

</Project>
