<UserControl x:Class="CM26.Studio.Views.ImportGraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MenuBackBrush}"
                BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Import Graphics" FontWeight="Bold" FontSize="15" />
        </Border>

        <!-- ImportGraphicsForm layout: Input / Output folders + import buttons -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Folders" Style="{StaticResource GroupCard}" Margin="0,0,0,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Input" FontWeight="Bold" Width="50" VerticalAlignment="Center" />
                        <TextBox x:Name="InputFolderBox" Width="400" />
                        <Button Content="Browse" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Output" FontWeight="Bold" Width="50" VerticalAlignment="Center" />
                        <TextBox x:Name="OutputFolderBox" Width="400" />
                        <Button Content="Browse" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Import" Style="{StaticResource GroupCard}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import Minifaces" Style="{StaticResource ClassicButton}" />
                    <Button Content="Import Kits" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBlock Grid.Row="2" x:Name="CounterText" Text="_ _ _ _ _ _ _" Style="{StaticResource MutedText}" FontSize="13" />
        </Grid>
    </Grid>
</UserControl>