<UserControl x:Class="CM26.Studio.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MenuBackBrush}"
                BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Audio" FontWeight="Bold" FontSize="15" />
        </Border>

        <!-- AudioForm layout: groupAudio (Player Audio) + groupNameDictionary (Names Dictionary) + groupExploreAudio -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox Header="Player Audio" Style="{StaticResource GroupCard}" Margin="0,0,6,6">
                    <StackPanel>
                        <TextBlock Text="Player Id" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <TextBox Text="0" IsEnabled="False" Margin="0,2,0,4" />
                        <TextBlock Text="Audio Name" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <TextBox Text="&lt;Not Assigned&gt;" IsEnabled="False" Margin="0,2,0,4" />
                        <TextBlock Text="Known As" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <TextBox IsEnabled="False" Margin="0,2,0,4" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Names Dictionary" Style="{StaticResource GroupCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border Background="{StaticResource MenuBackBrush}" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Search" FontWeight="Bold" Margin="0,0,8,0" />
                                <TextBox x:Name="NameSearchBox" Width="140" />
                                <Button Content="Search Exactly" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                                <Button Content="Search if starting with" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                                <Button Content="Search if containing" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ListBox Height="220" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Add" Style="{StaticResource ClassicButton}" />
                            <Button Content="Replace" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                            <Button Content="Remove" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource PanelBackBrush}" />

            <GroupBox Grid.Column="2" Header="Exploring:" Style="{StaticResource GroupCard}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Sound import / export (.sps / .wav) requires the audio asset pipeline."
                               Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Sound File" Style="{StaticResource ClassicButton}" />
                        <Button Content="Play Sounds" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                        <Button Content="Export Sounds (.sps format)" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                        <Button Content="Export Sounds (.wav format)" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Patching:" Style="{StaticResource GroupCard}" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock Text="Audio patch creation requires the audio asset pipeline."
                               Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create Patch" Style="{StaticResource ClassicButton}" />
                        <Button Content="Apply Patch" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource PanelBackBrush}" />

            <GroupBox Grid.Column="2" Header="Sound Split and Merge" Style="{StaticResource GroupCard}" Margin="6,6,0,0">
                <StackPanel>
                    <TextBlock Text="Sound splitting / merging (.sps / .wav) requires the audio asset pipeline."
                               Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Split Sound" Style="{StaticResource ClassicButton}" />
                        <Button Content="Merge Sounds" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>