<UserControl x:Class="CM26.Studio.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MenuBackBrush}"
                BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Browser" FontWeight="Bold" FontSize="15" />
        </Border>

        <!-- WebBrowserForm toolStripWeb: site shortcuts + import -->
        <Border Grid.Row="1" Background="{StaticResource MenuBackBrush}"
                BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back" Style="{StaticResource ClassicButton}" />
                <Button Content="Forward" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                <Button Content="Sofifa" Style="{StaticResource ClassicButton}" Margin="12,0,0,0" />
                <Button Content="Transfermarkt" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                <Button Content="Sortitoutsi" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
                <Separator Margin="12,0" />
                <Button Content="Import Web" Style="{StaticResource ClassicButton}" />
                <Button Content="Reload" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- WebView2 host -->
        <Border Grid.Row="2" Margin="12" Background="White" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1">
            <TextBlock Text="Web browser (WebView2) will be available in a later release."
                       Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>