<UserControl x:Class="CM26.Studio.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CM26.Studio.Controls"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate">
            <controls:FieldRow Pending="{Binding StageEditDelegate, ElementName=Root}" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- CM16 PlayerForm selects the player in this top strip; it has no
             second master list consuming half of the editor workspace. -->
        <controls:PickUpControl x:Name="PickUp" DockPanel.Dock="Top"
                                FilterEnabled="True" RefreshButtonEnabled="True" />

        <!-- ============ Right: CM16 tabEditPlayer (Info / Skills / Face) ============ -->
        <TabControl x:Name="EditTabs" Margin="4"
                    Background="{StaticResource WindowBackBrush}"
                    BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                    FontSize="13">

            <!-- ===== pageInfo ===== -->
            <TabItem Header="Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <GroupBox Header="Identity Card" Style="{StaticResource GroupCard}" Width="400">
                            <ItemsControl x:Name="IdentityFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Body" Style="{StaticResource GroupCard}" Width="400">
                            <ItemsControl x:Name="BodyFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Look" Style="{StaticResource GroupCard}" Width="400">
                            <ItemsControl x:Name="LookFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Playing for" Style="{StaticResource GroupCard}" Width="240">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="Club" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ClubPicker" SelectionChanged="ClubPicker_SelectionChanged" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="TeamFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Shoes" Style="{StaticResource GroupCard}" Width="240">
                            <ItemsControl x:Name="ShoesFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Playing Info" Style="{StaticResource GroupCard}" Width="240">
                            <ItemsControl x:Name="PositionFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== pageSkills (CM16: ... + Traits + Virtual Pro) ===== -->
            <TabItem Header="Skills">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <GroupBox Header="Random Generation" Style="{StaticResource GroupCard}" Width="270">
                            <StackPanel Margin="0,4,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Overall" FontWeight="Bold" Margin="0,0,8,0" />
                                    <TextBlock x:Name="OverallText" Text="—" FontWeight="Bold" />
                                </DockPanel>
                                <Slider x:Name="OverallSlider" Minimum="0" Maximum="99" IsSnapToTickEnabled="True"
                                        TickFrequency="1" ValueChanged="OverallSlider_ValueChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Superstar" Style="{StaticResource ClassicButton}" Click="Randomize_Click" Tag="99" />
                                    <Button Content="Very Good" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" Click="Randomize_Click" Tag="85" />
                                    <Button Content="Good" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" Click="Randomize_Click" Tag="75" />
                                    <Button Content="Average" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" Click="Randomize_Click" Tag="65" />
                                    <Button Content="Poor" Style="{StaticResource ClassicButton}" Margin="6,0,0,0" Click="Randomize_Click" Tag="50" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Goalkeeper Skills" Style="{StaticResource GroupCard}" Width="190">
                            <ItemsControl x:Name="GkFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Defensive Skills" Style="{StaticResource GroupCard}" Width="190">
                            <ItemsControl x:Name="DefensiveFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Midfielder Skills" Style="{StaticResource GroupCard}" Width="190">
                            <ItemsControl x:Name="MidfielderFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Mental Skills" Style="{StaticResource GroupCard}" Width="190">
                            <ItemsControl x:Name="MentalFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Attacking Skills" Style="{StaticResource GroupCard}" Width="190">
                            <ItemsControl x:Name="AttackingFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Physical Skills" Style="{StaticResource GroupCard}" Width="220">
                            <ItemsControl x:Name="PhysicalFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Free Kick Skills" Style="{StaticResource GroupCard}" Width="230">
                            <ItemsControl x:Name="FreeKickFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </GroupBox>
                        <GroupBox Header="Traits" Style="{StaticResource GroupCard}" Width="620">
                            <controls:PlaystyleGrid x:Name="TraitsGrid" Columns="3" />
                        </GroupBox>
                        <GroupBox Header="Virtual Pro" Style="{StaticResource GroupCard}" Width="620">
                            <controls:PlaystyleGrid x:Name="VirtualProGrid" Columns="2" PlusVariant="True" />
                        </GroupBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== pageFace (CM16: Face Modelling > Face Type / Hair Model and Color / Head Model) ===== -->
            <TabItem Header="Face">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Face Preview" Style="{StaticResource GroupCard}">
                            <StackPanel Orientation="Horizontal">
                                <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Background="White" Margin="6">
                                    <Image x:Name="FacePreview" Stretch="Uniform" Width="256" Height="256" Margin="4"/>
                                </Border>
                                <StackPanel Margin="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="FaceCaption" Style="{StaticResource MutedText}" Text="Player face texture" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Import" Width="70" ToolTip="Replace the player face texture" Click="ImportFace_Click"/>
                                        <Button Content="Remove" Width="70" Margin="6,0,0,0" ToolTip="Remove staged face texture" Click="RemoveFace_Click"/>
                                        <Button Content="Export" Width="70" Margin="6,0,0,0" ToolTip="Export the installed face texture" Click="ExportFace_Click"/>
                                    </StackPanel>
                                    <Button Content="Open 3D Face Viewer…" Width="180" Margin="0,4,0,0" ToolTip="Export the real head mesh and open the CM26 3D viewer" Click="Open3DFace_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Face Modelling" Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <controls:NamedCheckField x:Name="CheckHasGenericFace" />
                                <StackPanel x:Name="GenericFaceControls">
                                <GroupBox Header="Face Type" Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <controls:NamedComboField x:Name="ComboSkinType" />
                                        <controls:NamedComboField x:Name="ComboSkinTone" />
                                        <controls:NamedComboField x:Name="ComboEyesBrow" />
                                        <controls:NamedComboField x:Name="ComboFacialHair" />
                                        <controls:NamedComboField x:Name="ComboFacialHairColor" />
                                        <ItemsControl x:Name="FaceTypeFields" ItemTemplate="{StaticResource FieldTemplate}" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Hair Model and Color" Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <controls:GroupedModelPicker x:Name="ComboHairModel" />
                                        <controls:NamedComboField x:Name="ComboHairColor" />
                                        <ItemsControl x:Name="HairFields" ItemTemplate="{StaticResource FieldTemplate}" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Head Model" Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <controls:GroupedModelPicker x:Name="ComboHeadModel" />
                                        <controls:NamedComboField x:Name="ComboSideburns" />
                                        <controls:NamedComboField x:Name="ComboEyesColor" />
                                        <controls:NamedComboField x:Name="ComboFacePoser" />
                                        <controls:NamedCheckField x:Name="CheckHighQualityHead" />
                                        <ItemsControl x:Name="HeadFields" ItemTemplate="{StaticResource FieldTemplate}" />
                                    </StackPanel>
                                </GroupBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
