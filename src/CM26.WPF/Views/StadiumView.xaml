<UserControl x:Class="CM26.Studio.Views.StadiumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CM26.Studio.Controls"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate">
            <controls:FieldRow Pending="{Binding StageEditDelegate, ElementName=Root}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="7*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- Left: Find + stadium list (CM16 PickUpControl) -->
        <DockPanel Grid.Column="0" Margin="6">
            <Border DockPanel.Dock="Top" Background="{StaticResource MenuBackBrush}"
                    BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Margin="0,0,0,6" Padding="6,4">
                <DockPanel>
                    <TextBlock Text="Find:" FontWeight="Bold" Margin="0,0,8,0" />
                    <Button x:Name="NewIdButton" DockPanel.Dock="Right" Content="New ID" Style="{StaticResource ClassicButton}" Margin="8,0,0,0" Click="NewId_Click" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>
            <ListView x:Name="StadiumList" SelectionChanged="StadiumList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Id" Width="70" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,4,0,0" FontSize="12" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource PanelBackBrush}" />

        <!-- Right: tabEsitStadium (General / Preview / Model) -->
        <TabControl x:Name="EditTabs" Grid.Column="2" Margin="0,6,6,6"
                    Background="{StaticResource WindowBackBrush}"
                    BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                    FontSize="13">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel>
                        <!-- groupBox1: Info -->
                        <GroupBox Header="Info" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="InfoFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupMowingPattern -->
                        <GroupBox Header="Mowing Pattern" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="MowingFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupBox3: Net -->
                        <GroupBox Header="Net" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="NetFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupAdboards -->
                        <GroupBox Header="Adboards" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="AdboardFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupCamera -->
                        <GroupBox Header="Camera" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="CameraFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupTimeAndWeather -->
                        <GroupBox Header="Time and Weather" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="WeatherFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupPolice -->
                        <GroupBox Header="Police" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="PoliceFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <!-- groupBox9/10: Tech Zones -->
                        <GroupBox Header="Tech Zone Home" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="TechHomeFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Tech Zone Away" Style="{StaticResource GroupCard}" Margin="6" Width="280">
                            <StackPanel>
                                <ItemsControl x:Name="TechAwayFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Preview">
                <Grid Margin="12">
                    <TextBlock Text="Stadium preview images (import/export) will be supported in a later release."
                               Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </TabItem>
            <TabItem Header="Model">
                <Grid Margin="12">
                    <TextBlock Text="Stadium model textures (3D) will be supported in a later release."
                               Style="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>