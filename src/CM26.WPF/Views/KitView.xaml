<UserControl x:Class="CM26.Studio.Views.KitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CM26.Studio.Controls"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate">
            <controls:FieldRow Pending="{Binding StageEditDelegate, ElementName=Root}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="7*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- Left: Find + kit list -->
        <DockPanel Grid.Column="0" Margin="6">
            <Border DockPanel.Dock="Top" Background="{StaticResource MenuBackBrush}"
                    BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Margin="0,0,0,6" Padding="6,4">
                <DockPanel>
                    <TextBlock Text="Find:" FontWeight="Bold" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>
            <ListView x:Name="KitList" SelectionChanged="KitList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Team" Width="180" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Kit" Width="80" DisplayMemberBinding="{Binding Subtitle}" />
                        <GridViewColumn Header="Id" Width="70" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,4,0,0" FontSize="12" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource PanelBackBrush}" />

        <!-- Right: group layout of KitForm -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <GroupBox Header="Identity" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="IdentityFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Colors" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="ColorFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Jersey" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="JerseyFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Shorts" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="ShortsFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Name" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="NameFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Numbers" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="NumberFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Socks" Style="{StaticResource GroupCard}" Margin="6" Width="300">
                    <StackPanel>
                        <ItemsControl x:Name="SockFields" ItemTemplate="{StaticResource FieldTemplate}" />
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>