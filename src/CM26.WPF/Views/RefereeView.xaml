<UserControl x:Class="CM26.Studio.Views.RefereeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CM26.Studio.Controls"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate">
            <controls:FieldRow Pending="{Binding StageEditDelegate, ElementName=Root}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="7*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- Left: Find + referee list -->
        <DockPanel Grid.Column="0" Margin="6">
            <Border DockPanel.Dock="Top" Background="{StaticResource MenuBackBrush}"
                    BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Margin="0,0,0,6" Padding="6,4">
                <DockPanel>
                    <TextBlock Text="Find:" FontWeight="Bold" Margin="0,0,8,0" />
                    <Button x:Name="NewIdButton" DockPanel.Dock="Right" Content="New ID" Style="{StaticResource ClassicButton}" Margin="8,0,0,0" Click="NewId_Click" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
                </DockPanel>
            </Border>
            <ListView x:Name="RefereeList" SelectionChanged="RefereeList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Id" Width="70" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,4,0,0" FontSize="12" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource PanelBackBrush}" />

        <!-- Right: splitContainer1 (identity left, face right) -->
        <Grid Grid.Column="2" Margin="0,6,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- flowLayoutPanel1: groupIdentity (with nested groupShoes) + groupLeagues -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <GroupBox Header="Identity" Style="{StaticResource GroupCard}" Margin="0,0,0,6">
                        <StackPanel>
                            <ItemsControl x:Name="IdentityFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Shoes" Style="{StaticResource GroupCard}" Margin="0,0,0,6">
                        <StackPanel>
                            <ItemsControl x:Name="ShoesFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Leagues" Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <ItemsControl x:Name="LeagueFields" ItemTemplate="{StaticResource FieldTemplate}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource PanelBackBrush}" />

            <!-- groupGenericFace: Face Modelling (Face Type / Hair Model / Head Model) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Face Modelling" Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <GroupBox Header="Face Type" Style="{StaticResource GroupCard}">
                                <ItemsControl x:Name="FaceTypeFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </GroupBox>
                            <GroupBox Header="Hair Model" Style="{StaticResource GroupCard}">
                                <ItemsControl x:Name="HairFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </GroupBox>
                            <GroupBox Header="Head Model" Style="{StaticResource GroupCard}">
                                <ItemsControl x:Name="HeadFields" ItemTemplate="{StaticResource FieldTemplate}" />
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>