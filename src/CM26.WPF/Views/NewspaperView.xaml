<UserControl x:Class="CM26.Studio.Views.NewspaperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MenuBackBrush}"
                BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="0,0,0,1" Padding="8,4">
            <TextBlock Text="Newspaper" FontWeight="Bold" FontSize="15" />
        </Border>

        <!-- NewspapersForm layout: groupNewspaper + groupCmSponsor + groupSpecificTeamNews -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox Header="Newspaper" Style="{StaticResource GroupCard}" Margin="0,0,6,6">
                    <Border Background="{StaticResource PanelBackBrush}" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Height="220">
                        <TextBlock Text="Newspaper image" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </GroupBox>
                <GroupBox Header="CM Sponsor" Style="{StaticResource GroupCard}" Margin="0,0,6,0">
                    <Border Background="{StaticResource PanelBackBrush}" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Height="120">
                        <TextBlock Text="CM sponsor image" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </GroupBox>
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource PanelBackBrush}" />

            <GroupBox Grid.Column="2" Header="Specific Team News" Style="{StaticResource GroupCard}" Margin="6,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Team" FontWeight="Bold" Width="50" VerticalAlignment="Center" />
                        <ComboBox Width="240" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Type" FontWeight="Bold" Width="50" VerticalAlignment="Center" />
                        <ComboBox Width="240" />
                    </StackPanel>
                    <Border Background="{StaticResource PanelBackBrush}" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" Height="200" Margin="0,8,0,0">
                        <TextBlock Text="Team news image" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>