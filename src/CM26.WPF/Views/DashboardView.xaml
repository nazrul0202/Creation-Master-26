<UserControl x:Class="CM26.Studio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">
            <!-- Hero -->
            <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                    Background="{StaticResource GroupBackBrush}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FC26 DATABASE STUDIO" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Text="Creation Master 26" Style="{StaticResource SectionTitle}" Margin="0,6,0,0" />
                        <TextBlock x:Name="HeroSubtitle" Text="Loading workspace database…"
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource MenuBackBrush}"
                            BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                            Padding="16,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="HeroVersion" Text="v1.0.110" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="STUDIO" Style="{StaticResource MutedText}" FontSize="10"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Metrics -->
            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                        Background="{StaticResource GroupBackBrush}" Margin="0,0,6,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="MetricPlayers" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="PLAYERS" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                        Background="{StaticResource GroupBackBrush}" Margin="6,0,6,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="MetricTeams" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="#2E7D32" />
                        <TextBlock Text="TEAMS" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                        Background="{StaticResource GroupBackBrush}" Margin="6,0,6,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="MetricLeagues" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="#B8860B" />
                        <TextBlock Text="LEAGUES" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                        Background="{StaticResource GroupBackBrush}" Margin="6,0,0,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="MetricCountries" Text="—" FontSize="22" FontWeight="Bold"
                                   Foreground="#7B1FA2" />
                        <TextBlock Text="COUNTRIES" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick actions -->
            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource MutedText}" FontSize="10" Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Open FC26 (direct edit)" Style="{StaticResource ClassicButton}" Click="OpenGame_Click" />
                <Button Content="Reload Database" Style="{StaticResource ClassicButton}" Margin="8,0,0,0" Click="Reload_Click" />
            </StackPanel>

            <!-- Database info -->
            <TextBlock Text="DATABASE" Style="{StaticResource MutedText}" FontSize="10" Margin="0,18,0,8" />
            <Border BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1"
                    Background="{StaticResource GroupBackBrush}" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="DbPathText" Text="FC26 is not open yet" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DbTablesText" Text="" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
