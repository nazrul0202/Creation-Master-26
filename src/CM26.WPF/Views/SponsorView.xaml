<UserControl x:Class="CM26.Studio.Views.SponsorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CM26.Studio.Controls"
             x:Name="Root"
             Background="{StaticResource WindowBackBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldTemplate">
            <controls:FieldRow Pending="{Binding StageEditDelegate, ElementName=Root}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="7*" MinWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- Left: Find + sponsor list -->
        <DockPanel Grid.Column="0" Margin="6">
            <controls:PickUpControl x:Name="PickUp" DockPanel.Dock="Top" Margin="0,0,0,6"
                                    FilterEnabled="True" RefreshButtonEnabled="True" />
            <ListView x:Name="SponsorList" SelectionChanged="SponsorList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Id" Width="70" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,4,0,0" FontSize="12" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource PanelBackBrush}" />

        <!-- Right: sponsor fields -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <GroupBox Header="Sponsor" Style="{StaticResource GroupCard}" Margin="6">
                <StackPanel>
                    <ItemsControl x:Name="SponsorFields" ItemTemplate="{StaticResource FieldTemplate}" />
                </StackPanel>
            </GroupBox>
        </ScrollViewer>
    </Grid>
</UserControl>