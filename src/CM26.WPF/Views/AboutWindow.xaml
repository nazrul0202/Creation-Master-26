<Window x:Class="CM26.Studio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Info" Width="502" Height="459" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#14141A">
    <Grid>
        <StackPanel Margin="16,14,16,10" VerticalAlignment="Center">
            <TextBlock x:Name="LabelProduct" FontSize="12" FontWeight="Bold"
                       Foreground="White" Text="Creation Master 26" Margin="91,10,0,0" />
            <TextBlock x:Name="LabelRelease" FontSize="12" FontWeight="Bold"
                       Foreground="White" Margin="91,10,0,0" />
            <Button x:Name="ButtonGoBack" Content="Go Back" Width="81" Height="49"
                    HorizontalAlignment="Left" Margin="0,10,0,0"
                    Background="#14BE8C" Foreground="White" FontWeight="Bold"
                    FontSize="10" IsCancel="True" Click="GoBack_Click" />
            <TextBlock x:Name="LabelBody" FontSize="10" FontWeight="Bold"
                       Foreground="MediumSpringGreen" TextWrapping="Wrap"
                       Margin="0,18,0,0" />
            <TextBlock Text="Creation Master 26 is available at the following link"
                       FontSize="10" FontWeight="Bold" Foreground="MediumSpringGreen"
                       HorizontalAlignment="Center" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="Cyan" TextDecorations="Underline"
                           Cursor="Hand" Text="GitHub" MouseLeftButtonDown="GitHub_Click" Margin="0,0,24,0" />
                <TextBlock FontSize="12" Foreground="Cyan" TextDecorations="Underline"
                           Cursor="Hand" Text="Releases" MouseLeftButtonDown="Releases_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
