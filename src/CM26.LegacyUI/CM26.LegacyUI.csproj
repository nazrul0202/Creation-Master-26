<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>CM26.LegacyUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <!-- The classic shell retains decompiled designer/component fields and
         nullable annotations while targeting net48. These four diagnostics are
         intentional legacy-source noise; all other warnings remain visible and
         fail the release warning-baseline check. -->
    <NoWarn>$(NoWarn);CS8632;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="AssimpNet" Version="4.1.0" />
  </ItemGroup>

  <!-- ILSpy's legacy WinForms .resx payloads must be serialized by the .NET
       Framework reader. ResourcesCompiled contains that deterministic output;
       rebuilding it is documented by tools/LegacyResourceCompiler.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="ResourcesCompiled\*.resources">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CM26.Legacy.FifaLibrary\CM26.Legacy.FifaLibrary.csproj" />
    <ProjectReference Include="..\CM26.Legacy.FifaControls\CM26.Legacy.FifaControls.csproj" />
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>vendor\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>vendor\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>vendor\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HtmlAgilityPack">
      <HintPath>vendor\HtmlAgilityPack.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Xml" />
    <Reference Include="System.Data" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="vendor\Microsoft.DirectX.dll" Link="Microsoft.DirectX.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\Microsoft.DirectX.Direct3D.dll" Link="Microsoft.DirectX.Direct3D.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\Microsoft.DirectX.Direct3DX.dll" Link="Microsoft.DirectX.Direct3DX.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\zlib.net.dll" Link="zlib.net.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\EASounds.dll" Link="EASounds.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\SpeexSharp.dll" Link="SpeexSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\libspeex.dll" Link="libspeex.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor\WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FC26's complete structured snapshot is intentionally available to the
       classic x86 editor (including Advanced Database Workspace).  Mark the
       process Large Address Aware so it can use the full 4 GB user address
       space on 64-bit Windows instead of failing near the legacy 2 GB limit. -->
  <Target Name="SetLegacyLargeAddressAware" AfterTargets="CopyFilesToOutputDirectory">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\SetLargeAddressAware.ps1&quot; -Path &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
