<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CM26.App</RootNamespace>
    <AssemblyName>CM26_by_Rizco98</AssemblyName>
    <AssemblyTitle>Creation Master 26</AssemblyTitle>
    <Description>Creation Master 26 — database, competition data and legacy asset editor</Description>
    <ApplicationIcon>Assets\Logo\Creation Master 26.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <HighDpiAwareness>PerMonitorV2</HighDpiAwareness>
    <!-- Version, Company, Product, Copyright and release debug/PathMap settings
         are inherited from Directory.Build.props (single source of truth). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep local source snapshots available without compiling a second PlayersSection type. -->
    <Compile Remove="Sections\PlayersSectionBACKUP.cs" />
    <ProjectReference Include="..\CM26.AssetBridge\CM26.AssetBridge.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CM26.Application\CM26.Application.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <Reference Include="CM26.EngineBridge">
      <HintPath>..\..\src-native\CM26.EngineBridge\bin\CM26.EngineBridge.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\src-native\CM26.EngineBridge\bin\Ijwhost.dll">
      <Link>Ijwhost.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The asset bridge runs as a separate process next to the app. It carries its
       own MeshKit copy via ProjectReference, so both are taken from the bridge
       output directory. Using the bridge's own output avoids the stale-DLL trap
       of globbing a hardcoded Debug/Release path that the solution may not build. -->
  <Target Name="CopyAssetBridge" AfterTargets="Build">
    <PropertyGroup>
      <AssetBridgeOutDir>..\CM26.AssetBridge\bin\$(Configuration)\net8.0-windows\</AssetBridgeOutDir>
    </PropertyGroup>
    <ItemGroup>
      <AssetBridgeFiles Include="$(AssetBridgeOutDir)CM26.AssetBridge.*" />
      <AssetBridgeFiles Include="$(AssetBridgeOutDir)CM26.MeshKit.dll" />
    </ItemGroup>
    <Error Condition="'@(AssetBridgeFiles)' == ''"
           Text="Asset bridge output not found in $(AssetBridgeOutDir). Build CM26.AssetBridge first (it is part of CM26.slnx)." />
    <Copy SourceFiles="@(AssetBridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish the helper with the same runtime model as the main application.
       Copying its ordinary build output made the Full Portable package depend
       on an externally installed Microsoft.NETCore.App. -->
  <Target Name="PublishAssetBridgeToAppOutput" AfterTargets="Publish">
    <PropertyGroup>
      <AbsoluteAppPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</AbsoluteAppPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\CM26.AssetBridge\CM26.AssetBridge.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(AbsoluteAppPublishDir);DebugSymbols=false;DebugType=None"
             Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- The packaged 3D FBX viewer. Its payload is a prebuilt drop; warn loudly when
       it is absent so a package is never shipped with an empty Tools folder. -->
  <Target Name="CopyThreeDViewer" AfterTargets="Build">
    <ItemGroup>
      <ThreeDViewerFiles Include="..\..\publish_3d_viewer\**\*" />
    </ItemGroup>
    <Warning Condition="'@(ThreeDViewerFiles)' == ''"
             Text="publish_3d_viewer is empty or missing: this build will have no bundled 3D viewer under Tools\CM26.3DViewer." />
    <Copy SourceFiles="@(ThreeDViewerFiles)"
          DestinationFiles="@(ThreeDViewerFiles->'$(OutDir)Tools\CM26.3DViewer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyThreeDViewerToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ThreeDViewerPublishFiles Include="..\..\publish_3d_viewer\**\*" />
    </ItemGroup>
    <Error Condition="'@(ThreeDViewerPublishFiles)' == '' And '$(PublishDir)' != ''"
           Text="publish_3d_viewer is empty or missing. A published release package must contain the 3D viewer; restore publish_3d_viewer before publishing." />
    <Copy SourceFiles="@(ThreeDViewerPublishFiles)"
          DestinationFiles="@(ThreeDViewerPublishFiles->'$(PublishDir)Tools\CM26.3DViewer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- The CM26 Scraper is an optional separate download and is deliberately NOT
       bundled: its data set contains EA-derived database content that this project
       does not redistribute (see EULA.md and KNOWN_LIMITATIONS.md). Data Sync
       locates a user-installed copy at runtime via ExternalToolLocator. -->

  <Target Name="CopyCommercialDocs" AfterTargets="Build">
    <Copy SourceFiles="..\..\LICENSE;..\..\EULA.md;..\..\version.json"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCommercialDocsToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="..\..\LICENSE;..\..\EULA.md;..\..\version.json"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png" />
    <EmbeddedResource Include="Assets\Logo\*.png" />
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.es.resx" />
  </ItemGroup>

  <!-- Copy the app icon + brand PNGs next to the exe so MainForm can load the window icon at runtime. -->
  <ItemGroup>
    <None Include="Assets\Logo\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
