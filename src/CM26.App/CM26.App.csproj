<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CM26.App</RootNamespace>
    <AssemblyName>CM26_by_Rizco98</AssemblyName>
    <Product>Creation Master 26</Product>
    <AssemblyTitle>Creation Master 26</AssemblyTitle>
    <Version>1.0.21</Version>
    <AssemblyVersion>1.0.21.0</AssemblyVersion>
    <FileVersion>1.0.21.0</FileVersion>
    <InformationalVersion>1.0.21</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Rizco98</Company>
    <Description>Creation Master 26 — database, competition data and legacy asset editor</Description>
    <Copyright>Community tool by Rizco98 — not affiliated with or endorsed by EA SPORTS</Copyright>
    <ApplicationIcon>Assets\Logo\Creation Master 26.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <HighDpiAwareness>PerMonitorV2</HighDpiAwareness>
    <!-- Release ships without PDBs and without embedded absolute build/source paths. -->
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)\=cm26\,$(SolutionDir)\=cm26\</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CM26.AssetBridge\CM26.AssetBridge.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CM26.Application\CM26.Application.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <Reference Include="CM26.EngineBridge">
      <HintPath>..\..\src-native\CM26.EngineBridge\bin\CM26.EngineBridge.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\src-native\CM26.EngineBridge\bin\Ijwhost.dll">
      <Link>Ijwhost.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyAssetBridge" AfterTargets="Build">
    <ItemGroup>
      <AssetBridgeFiles Include="..\CM26.AssetBridge\bin\$(Configuration)\net8.0-windows\CM26.AssetBridge.*" />
      <MeshKitFiles Include="..\CM26.MeshKit\bin\$(Configuration)\net8.0\CM26.MeshKit.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssetBridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MeshKitFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish the helper with the same runtime model as the main application.
       Copying its ordinary build output made the Full Portable package depend
       on an externally installed Microsoft.NETCore.App. -->
  <Target Name="PublishAssetBridgeToAppOutput" AfterTargets="Publish">
    <PropertyGroup>
      <AbsoluteAppPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</AbsoluteAppPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\CM26.AssetBridge\CM26.AssetBridge.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(AbsoluteAppPublishDir);DebugSymbols=false;DebugType=None"
             Condition="'$(PublishDir)' != ''" />
  </Target>

  <Target Name="CopyThreeDViewer" AfterTargets="Build">
    <ItemGroup>
      <ThreeDViewerFiles Include="..\..\publish_3d_viewer\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ThreeDViewerFiles)"
          DestinationFiles="@(ThreeDViewerFiles->'$(OutDir)Tools\CM26.3DViewer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyThreeDViewerToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ThreeDViewerPublishFiles Include="..\..\publish_3d_viewer\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ThreeDViewerPublishFiles)"
          DestinationFiles="@(ThreeDViewerPublishFiles->'$(PublishDir)Tools\CM26.3DViewer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- The CM26 Scraper ships inside the package under Tools\CM26 Scraper so the
       Data Sync page can open it and detect its squad output directly. -->
  <Target Name="CopyScraper" AfterTargets="Build">
    <ItemGroup>
      <ScraperFiles Include="..\..\publish_scraper\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ScraperFiles)"
          DestinationFiles="@(ScraperFiles->'$(OutDir)Tools\CM26 Scraper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyScraperToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ScraperPublishFiles Include="..\..\publish_scraper\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ScraperPublishFiles)"
          DestinationFiles="@(ScraperPublishFiles->'$(PublishDir)Tools\CM26 Scraper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png" />
    <EmbeddedResource Include="Assets\Logo\*.png" />
  </ItemGroup>

  <!-- Copy the app icon + brand PNGs next to the exe so MainForm can load the window icon at runtime. -->
  <ItemGroup>
    <None Include="Assets\Logo\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
