<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>FifaLibrary16</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <RootNamespace />
    <!-- The original CM16-era library intentionally retains decompiled fields
         used by binary layout compatibility. Suppress only unused-symbol noise;
         all semantic compiler warnings remain release blockers. -->
    <NoWarn>$(NoWarn);CS0219;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Numerics" />
    <Reference Include="zlib.net">
      <HintPath>..\CM26.LegacyUI\vendor\zlib.net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
